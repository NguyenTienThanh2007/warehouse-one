{
  "$id": "https://github.com/NguyenTienThanh2007/warehouse-one/data/schemas/simulation-command.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "const": "inventory.receive"
        },
        "payload": {
          "type": "object",
          "properties": {
            "location_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "sku": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "quantity": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "location_id",
            "sku",
            "quantity"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "command_id",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "const": "inventory.move"
        },
        "payload": {
          "type": "object",
          "properties": {
            "from_location_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "to_location_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "sku": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "quantity": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1000000
            }
          },
          "required": [
            "from_location_id",
            "to_location_id",
            "sku",
            "quantity"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "command_id",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "const": "inventory.adjust"
        },
        "payload": {
          "type": "object",
          "properties": {
            "location_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "sku": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "delta": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "reason": {
              "type": "string",
              "enum": [
                "cycle_count",
                "damage",
                "correction"
              ]
            }
          },
          "required": [
            "location_id",
            "sku",
            "delta",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "command_id",
        "type",
        "payload"
      ],
      "additionalProperties": false
    }
  ]
}
