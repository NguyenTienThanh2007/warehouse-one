# Copy to .env for local overrides. Never commit real secrets; .env is git-ignored.

# --- Docker Compose (local development defaults) ---
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse_dev
POSTGRES_DB=warehouse_one
# Host ports only (inside Compose, services use postgres:5432 and api:8000). If you change them,
# keep WAREHOUSE_DATABASE_URL and NEXT_PUBLIC_API_URL below on the same ports.
POSTGRES_PORT=5432
API_PORT=8000

# --- Phase 3 data platform (docker compose --profile data); local-development defaults ---
KAFKA_PORT=9094
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
AIRFLOW_PORT=8080
MINIO_ROOT_USER=warehouse
MINIO_ROOT_PASSWORD=warehouse_dev_minio
WAREHOUSE_LAKE_BUCKET=warehouse-lake

# --- API (apps/api, prefix WAREHOUSE_) ---
WAREHOUSE_ENV=development
WAREHOUSE_LOG_LEVEL=INFO
# For the API and tests run on the host (Compose sets its own); the port is POSTGRES_PORT.
WAREHOUSE_DATABASE_URL=postgresql+psycopg://warehouse:warehouse_dev@localhost:5432/warehouse_one
# Replaces the default list: keep every web origin you use (3000: pnpm dev, 3100: browser tests).
# In development the API also accepts any localhost origin; this list is what other envs allow.
WAREHOUSE_CORS_ORIGINS=["http://localhost:3000","http://localhost:3100"]

# --- Pipeline processes run on the host (warehouse-pipeline; in Compose these are preset) ---
# WAREHOUSE_KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# WAREHOUSE_S3_ENDPOINT=localhost:9000
# WAREHOUSE_S3_ACCESS_KEY=warehouse
# WAREHOUSE_S3_SECRET_KEY=warehouse_dev_minio

# --- Web (apps/web) — NEXT_PUBLIC_* values are exposed to the browser; never put secrets here ---
# Read by pnpm dev / next build from this file too; defaults to http://localhost:$API_PORT.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI explanations (Phase 6; API server only, never NEXT_PUBLIC_*) ---
# Optional. Without them the optimiser, what-if comparisons and approvals work; the AI mode says
# that AI is not configured. The key is never logged or returned by the API.
WAREHOUSE_AI_PROVIDER=none
# WAREHOUSE_AI_PROVIDER=anthropic
# WAREHOUSE_AI_API_KEY=
# WAREHOUSE_AI_MODEL=claude-opus-5-5
