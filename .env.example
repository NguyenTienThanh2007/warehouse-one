# Copy to .env for local overrides. Never commit real secrets; .env is git-ignored.

# --- Docker Compose (local development defaults) ---
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse_dev
POSTGRES_DB=warehouse_one
POSTGRES_PORT=5432
API_PORT=8000

# --- Phase 3 data platform (docker compose --profile data); local-development defaults ---
KAFKA_PORT=9094
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
AIRFLOW_PORT=8080
MINIO_ROOT_USER=warehouse
MINIO_ROOT_PASSWORD=warehouse_dev_minio
WAREHOUSE_LAKE_BUCKET=warehouse-lake

# --- API (apps/api, prefix WAREHOUSE_) ---
WAREHOUSE_ENV=development
WAREHOUSE_LOG_LEVEL=INFO
WAREHOUSE_DATABASE_URL=postgresql+psycopg://warehouse:warehouse_dev@localhost:5432/warehouse_one
WAREHOUSE_CORS_ORIGINS=["http://localhost:3000","http://localhost:3100"]

# --- Pipeline processes run on the host (warehouse-pipeline; in Compose these are preset) ---
# WAREHOUSE_KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# WAREHOUSE_S3_ENDPOINT=localhost:9000
# WAREHOUSE_S3_ACCESS_KEY=warehouse
# WAREHOUSE_S3_SECRET_KEY=warehouse_dev_minio

# --- Web (apps/web) — NEXT_PUBLIC_* values are exposed to the browser; never put secrets here ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI providers (Phase 5; server-side only, never NEXT_PUBLIC_) ---
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
