{
  "name": "warehouse-one",
  "private": true,
  "description": "WAREHOUSE ONE \u2014 3D logistics digital twin and real-time data engineering platform.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @warehouse-one/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tests/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "bench:sim": "pnpm --filter @warehouse-one/simulation bench",
    "bench:twin": "pnpm --filter @warehouse-one/twin bench",
    "schemas:generate": "pnpm --filter @warehouse-one/contracts generate:schemas",
    "fixtures:generate": "pnpm --filter @warehouse-one/simulation generate:fixtures && pnpm --filter @warehouse-one/twin generate:fixtures",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "bench:render": "tsx tests/performance/render-benchmark.ts",
    "capture:bookmarks": "tsx tests/performance/capture-bookmarks.ts",
    "capture:operations": "tsx tests/performance/capture-operations.ts",
    "capture:network": "tsx tests/performance/capture-network.ts",
    "sim:record": "pnpm --filter @warehouse-one/recorder record",
    "sim:verify": "pnpm --filter @warehouse-one/recorder verify",
    "twin:verify": "pnpm --filter @warehouse-one/twin verify"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@warehouse-one/contracts": "workspace:*",
    "@warehouse-one/recorder": "workspace:*",
    "@warehouse-one/simulation": "workspace:*",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
